# ===== 数据库配置 =====
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 服务端口 =====
SERVER_PORT=8080

# ===== JWT =====
JWT_SECRET=请生成一个随机字符串替换这里

# ===== 百度 AI（图像分类） =====
BAIDU_AI_APP_ID=your-baidu-app-id
BAIDU_AI_API_KEY=your-baidu-api-key
BAIDU_AI_SECRET_KEY=your-baidu-secret-key

# ===== 智谱 GLM-4V（原版 VLM） =====
GLM_API_KEY=your-glm-api-key

# ===== 通义千问 Qwen-VL（省钱版 VLM） =====
QWEN_VL_API_KEY=your-qwen-api-key

# ===== Google Gemini 2.5 Flash（最强版 VLM） =====
GEMINI_API_KEY=your-gemini-api-key
